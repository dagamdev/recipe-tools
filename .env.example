# Postgres (Supabase, Neon...). Si se deja vacío en desarrollo, se usa PGlite en .data/
DATABASE_URL=

# Secreto para firmar sesiones: genera uno con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# URL pública de la app (en local: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# Opcional: inicio de sesión con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
