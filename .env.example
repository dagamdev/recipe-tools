# Postgres (Supabase, Neon...). En desarrollo `pnpm dev` usa PGlite si se deja vacío
DATABASE_URL=

# Secreto para firmar sesiones: genera uno con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# URL pública de la app (en local: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# Inicio de sesión con Google (obligatorio: es la única forma de entrar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
